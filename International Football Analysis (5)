turn \"Qualifier\"\n","\n","    continental_terms = [\n","        \"uefa euro\",\n","        \"copa américa\",\n","        \"copa america\",\n","        \"african cup\",\n","        \"asian cup\",\n","        \"concacaf gold\",\n","        \"oceania\",\n","        \"nations cup\",\n","        \"championship\"\n","    ]\n","\n","    if any(term in text for term in continental_terms):\n","        return \"Continental Cup\"\n","\n","    return \"Other\"\n","\n","# ==========================\n","# DATA CLEANING\n","# ==========================\n","\n","# Hapus duplikat\n","results = results_raw.drop_duplicates().copy()\n","\n","# Bersihkan nama kolom\n","results.columns = results.columns.str.strip()\n","\n","# Bersihkan kolom teks\n","text_cols = [\n","    \"home_team\",\n","    \"away_team\",\n","    \"tournament\",\n","    \"city\",\n","    \"country\"\n","]\n","\n","for col in text_cols:\n","    if col in results.columns:\n","        results[col] = clean_text(results[col])\n","\n","# Ubah tipe data\n","results[\"date\"] = pd.to_datetime(results[\"date\"], errors=\"coerce\")\n","results[\"home_score\"] = pd.to_numeric(results[\"home_score\"], errors=\"coerce\")\n","results[\"away_score\"] = pd.to_numeric(results[\"away_score\"], errors=\"coerce\")\n","\n","if \"neutral\" in results.columns:\n","    results[\"neutral\"] = results[\"neutral\"].astype(bool)\n","\n","# Hapus data yang tidak valid\n","results[\"impossible_score\"] = (\n","    (results[\"home_score\"] < 0) |\n","    (results[\"away_score\"] < 0) |\n","    (results[\"home_score\"] % 1 != 0) |\n","    (results[\"away_score\"] % 1 != 0)\n",")\n","\n","results_clean = results[\n","    results[\"date\"].notna() &\n","    results[\"home_score\"].notna() &\n","    results[\"away_score\"].notna() &\n","    (~results[\"impossible_score\"])\n","].copy()\n","\n","# Ubah skor menjadi integer\n","results_clean[\"home_score\"] = results_clean[\"home_score\"].astype(int)\n","results_clean[\"away_score\"] = results_clean[\"away_score\"].astype(int)\n","\n","# ==========================\n","# FEATURE ENGINEERING\n","# ==========================\n","\n","# Hasil pertandingan\n","results_clean[\"match_result\"] = np.select(\n","    [\n","        results_clean[\"home_score\"] > results_clean[\"away_score\"],\n","        results_clean[\"home_score\"] < results_clean[\"away_score\"]\n","    ],\n","    [\n","        \"Home Win\",\n","        \"Away Win\"\n","    ],\n","    default=\"Draw\"\n",")\n","\n","# Total gol\n","results_clean[\"total_goals\"] = (\n","    results_clean[\"home_score\"] +\n","    results_clean[\"away_score\"]\n",")\n","\n","# Selisih gol\n","results_clean[\"goal_difference\"] = (\n","    results_clean[\"home_score\"] -\n","    results_clean[\"away_score\"]\n",")\n","\n","# Tahun\n","results_clean[\"year\"] = results_clean[\"date\"].dt.year\n","\n","# Dekade\n","results_clean[\"decade\"] = (\n","    (results_clean[\"year\"] // 10) * 10\n",").astype(str) + \"s\"\n","\n","# Kategori turnamen\n","results_clean[\"tournament_category\"] = (\n","    results_clean[\"tournament\"]\n","    .apply(tournament_category)\n",")\n","\n","# Home advantage\n","if \"neutral\" in results_clean.columns:\n","    results_clean[\"home_advantage_flag\"] = ~results_clean[\"neutral\"]\n","\n","# ==========================\n","# HASIL\n","# ==========================\n","\n","print(\"Jumlah data awal :\", len(results_raw))\n","print(\"Jumlah data bersih :\", len(results_clean))\n","print(\"\\nKolom dataset:\")\n","print(results_clean.columns.tolist())\n","\n","display(results_clean.head())\n","results_clean.info()"],"metadata":{"id":"W9Q3rhYpSELB","executionInfo":{"status":"ok","timestamp":1786026290920,"user_tz":-420,"elapsed":3270,"user":{"displayName":"Kath Leen","userId":"02500473685621829400"}},"colab":{"base_uri":"https://localhost:8080/","height":816},"outputId":"1c6346e2-27f3-4b96-dbb6-95ba4644ffbc"},"execution_count":69,"outputs":[{"output_type":"stream","name":"stdout","text":["Jumlah d