]) if aws[\"points\"] else 0,\n","            \"elo_home\": home_elo,\n","            \"elo_away\": away_elo,\n","            \"elo_diff\": home_elo - away_elo,\n","        })\n","\n","        actual_home = 1 if r[\"home_score\"] > r[\"away_score\"] else 0.5 if r[\"home_score\"] == r[\"away_score\"] else 0\n","        home_boost = 0 if r[\"neutral\"] else 50\n","        expected_home = 1 / (1 + 10 ** (-(home_elo - away_elo + home_boost) / 400))\n","\n","        elo[home] = home_elo + k_factor * (actual_home - expected_home)\n","        elo[away] = away_elo + k_factor * ((1 - actual_home) - (1 - expected_home))\n","\n","        for team, gf, ga, won, point in [\n","            (home, r[\"home_score\"], r[\"away_score\"], r[\"match_result\"] == \"Home Win\", actual_home),\n","            (away, r[\"away_score\"], r[\"home_score\"], r[\"match_result\"] == \"Away Win\", 1 - actual_home),\n","        ]:\n","            s = team_stats.setdefault(team, {\"matches\": 0, \"wins\": 0, \"gf\": 0, \"ga\": 0, \"points\": []})\n","            s[\"matches\"] += 1\n","            s[\"wins\"] += int(won)\n","            s[\"gf\"] += int(gf)\n","            s[\"ga\"] += int(ga)\n","            s[\"points\"].append(point)\n","\n","    return pd.concat([df, pd.DataFrame(rows)], axis=1)\n","\n","featured = add_historical_features(results_clean)\n","display(featured.head())"]},{"cell_type":"code","source":["from sklearn.pipeline import Pipeline\n","from sklearn.impute import SimpleImputer\n","from sklearn.preprocessing import StandardScaler, OneHotEncoder\n","from sklearn.compose import ColumnTransformer"],"metadata":{"id":"QDDPJYY4e6r2","executionInfo":{"status":"ok","timestamp":1786026637961,"user_tz":-420,"elapsed":1885,"user":{"displayName":"Kath Leen","userId":"02500473685621829400"}}},"execution_count":110,"outputs":[]},{"cell_type":"code","execution_count":113,"metadata":{"executionInfo":{"elapsed":58,"status":"ok","timestamp":1786026650982,"user":{"displayName":"Kath Leen","userI